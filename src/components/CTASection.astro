---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  badge?: string;
  id?: string;
}

const {
  title = 'Tvoje telo nepotrebuje dokonalosť. Potrebuje opakovanie.',
  description = 'Stiahni si 30-dňový PDF plán Koniec Stresu. Denné cvičenia, jednoduché úlohy a audio nahrávky, ktoré ťa prevedú reguláciou nervovej sústavy krok za krokom.',
  buttonText = 'Získať plán',
  badge = '30-dňový plán · zadarmo',
  id = 'newsletter',
} = Astro.props;
---

<section class="cta" id={id}>
  <div class="cta-card">
    <span class="breadcrumb">{badge}</span>
    <h2 set:html={title}></h2>
    <p>{description}</p>
    <form class="cta-form" onsubmit="event.preventDefault(); alert('Tu pripoj svoj email service (ConvertKit, Buttondown, MailerLite atď.).');">
      <input type="email" placeholder="tvoj@email.sk" required aria-label="E-mail" />
      <button type="submit">{buttonText}</button>
    </form>
    <small>Zadarmo. Žiadny spam. Iba praktické nástroje.</small>
  </div>
</section>

<style>
  .cta {
    padding: 64px 24px;
  }

  .cta-card {
    max-width: 920px;
    margin: 0 auto;
    background: linear-gradient(135deg, var(--terracotta), var(--rose));
    border-radius: 36px;
    padding: 80px 40px;
    text-align: center;
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }

  .cta-card::before,
  .cta-card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .cta-card::before {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, var(--peach), transparent 70%);
    opacity: 0.4;
    top: -100px;
    right: -100px;
  }

  .cta-card::after {
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, var(--olive), transparent 70%);
    opacity: 0.3;
    bottom: -100px;
    left: -50px;
  }

  .cta-card > * {
    position: relative;
    z-index: 1;
  }

  .breadcrumb {
    display: inline-block;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--paper);
    margin-bottom: 20px;
    font-weight: 500;
  }

  .cta-card h2 {
    font-family: var(--display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    color: var(--paper);
  }

  .cta-card h2 :global(em) {
    font-style: italic;
    color: #ffe9d2;
  }

  .cta-card p {
    font-size: 19px;
    color: #fde8d4;
    max-width: 520px;
    margin: 0 auto 32px;
    line-height: 1.5;
  }

  .cta-form {
    display: flex;
    gap: 8px;
    max-width: 460px;
    margin: 0 auto;
    background: var(--paper);
    padding: 6px;
    border-radius: 999px;
  }

  .cta-form input {
    flex: 1;
    background: transparent;
    border: 0;
    padding: 14px 20px;
    font-size: 15px;
    color: var(--ink);
    outline: none;
    font-family: var(--sans);
  }

  .cta-form button {
    background: var(--ink);
    color: var(--paper);
    border: 0;
    border-radius: 999px;
    padding: 14px 26px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    font-family: var(--sans);
    transition: transform 0.2s;
  }

  .cta-form button:hover {
    transform: translateY(-1px);
  }

  .cta-card small {
    display: block;
    margin-top: 18px;
    color: #fde8d4;
    font-size: 13px;
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .cta-card {
      padding: 48px 24px;
    }
    .cta-form {
      flex-direction: column;
      background: transparent;
      padding: 0;
      border-radius: 0;
    }
    .cta-form input {
      background: var(--paper);
      border-radius: 999px;
      padding: 14px 22px;
    }
    .cta-form button {
      padding: 16px;
    }
  }
</style>
