---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand">
          <span class="brand-mark"></span>
          <span>Koniec Stresu</span>
        </a>
        <p class="tagline">
          Pomáham ti vrátiť pokoj nervovej sústave. Praktické techniky bez moralizovania.
        </p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <h4>Obsah</h4>
          <a href="/blog">Všetky články</a>
          <a href="/#meditacie">Meditácie</a>
          <a href="/#kurz">Kurz 30 dní</a>
        </div>
        <div class="footer-col">
          <h4>O mne</h4>
          <a href="/#o-mne">Kto som</a>
          <a href="/#kontakt">Kontakt</a>
          <a href="/#newsletter">Newsletter</a>
        </div>
        <div class="footer-col">
          <h4>Právne</h4>
          <a href="/ochrana-osobnych-udajov">Ochrana osobných údajov</a>
          <a href="/obchodne-podmienky">Obchodné podmienky</a>
        </div>
      </div>
    </div>

    <aside class="disclaimer" aria-labelledby="disclaimer-title">
      <p class="disclaimer-title" id="disclaimer-title">Dôležité upozornenie</p>
      <p class="disclaimer-body">
        Obsah na tejto stránke je <strong>vzdelávací a informačný</strong>. Nenahrádza odbornú lekársku, psychologickú ani psychiatrickú pomoc. Ak máš diagnostikovaný stav, dlhodobo zhoršené príznaky alebo užívaš lieky, postup s lekárom, nie podľa článku.
      </p>
      <p class="disclaimer-body">
        <strong>Ak prežívaš krízu, máš myšlienky na sebapoškodenie alebo si v akútnom strese, ozvi sa odbornej linke pomoci:</strong>
      </p>
      <ul class="crisis-lines">
        <li>
          <span class="crisis-region">Slovensko</span>
          <span class="crisis-name">Linka dôvery Nezábudka</span>
          <a class="crisis-tel" href="tel:0800800566" aria-label="Volať 0800 800 566">0800 800 566</a>
          <span class="crisis-meta">zadarmo, 24/7</span>
        </li>
        <li>
          <span class="crisis-region">Česko</span>
          <span class="crisis-name">Linka první psychické pomoci</span>
          <a class="crisis-tel" href="tel:116123" aria-label="Volať 116 123">116 123</a>
          <span class="crisis-meta">zadarmo, 24/7</span>
        </li>
        <li>
          <span class="crisis-region">Núdza (SK + CZ)</span>
          <span class="crisis-name">Záchranná zložka</span>
          <a class="crisis-tel" href="tel:112" aria-label="Volať 112">112</a>
          <span class="crisis-meta">24/7</span>
        </li>
        <li>
          <span class="crisis-region">Deti a mladiství</span>
          <span class="crisis-name">Linka detskej istoty</span>
          <a class="crisis-tel" href="tel:116111" aria-label="Volať 116 111">116 111</a>
          <span class="crisis-meta">SK + CZ, zadarmo, 24/7</span>
        </li>
      </ul>
    </aside>

    <div class="footer-bottom">
      <p>&copy; {year} Daniel Jedlička · 365 ACADEMY OÜ. Všetky práva vyhradené.</p>
      <p class="footer-note">
        koniecstresu.sk je vzdelávací projekt. Nenahrádza odbornú zdravotnú starostlivosť.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper);
    border-top: 1px solid var(--rule);
    margin-top: 96px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 64px 24px 32px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 48px;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--rule);
  }

  .footer-brand .brand {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--terracotta), var(--peach));
  }

  .tagline {
    font-size: 15px;
    color: var(--soft);
    line-height: 1.55;
    max-width: 380px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-col h4 {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--terracotta-deep);
    margin-bottom: 16px;
  }

  .footer-col a {
    display: block;
    font-size: 14px;
    color: var(--soft);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--terracotta-deep);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .footer-note {
    font-style: italic;
    max-width: 480px;
    text-align: right;
  }

  /* Crisis-line disclaimer block */
  .disclaimer {
    background: linear-gradient(180deg, var(--cream), var(--paper));
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: 26px 28px;
    margin-bottom: 24px;
  }
  .disclaimer-title {
    font-family: var(--display);
    font-style: italic;
    font-size: 20px;
    font-weight: 500;
    color: var(--terracotta-deep);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .disclaimer-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--soft);
    margin-bottom: 12px;
  }
  .disclaimer-body strong {
    color: var(--ink);
    font-weight: 600;
  }
  .crisis-lines {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 24px;
  }
  .crisis-lines li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'region tel'
      'name name'
      'meta meta';
    gap: 2px 12px;
    align-items: baseline;
    padding: 10px 12px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 12px;
    font-size: 13.5px;
  }
  .crisis-region {
    grid-area: region;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--terracotta-deep);
    font-weight: 700;
  }
  .crisis-tel {
    grid-area: tel;
    justify-self: end;
    font-family: var(--display);
    font-weight: 500;
    font-size: 18px;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .crisis-tel:hover {
    color: var(--terracotta);
  }
  .crisis-name {
    grid-area: name;
    color: var(--ink);
    font-weight: 500;
  }
  .crisis-meta {
    grid-area: meta;
    color: var(--muted);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .crisis-lines {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-note {
      text-align: left;
    }
  }
</style>
