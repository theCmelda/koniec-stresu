---
interface Props {
  href: string;
  title: string;
  description: string;
  category?: string;
  publishDate: Date;
  readingTime?: number;
  videoId?: string;
  featured?: boolean;
}

const {
  href,
  title,
  description,
  category = 'Stres',
  publishDate,
  readingTime,
  videoId,
  featured = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('sk-SK', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);

const thumb = videoId
  ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`
  : null;
---

<a href={href} class:list={['card', featured && 'featured']}>
  {thumb && (
    <div class="card-media">
      <img src={thumb} alt="" loading="lazy" />
      {videoId && <span class="play" aria-hidden="true">▶</span>}
    </div>
  )}
  <div class="card-body">
    <span class="card-tag">{category}</span>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <div class="card-meta">
      <time datetime={publishDate.toISOString()}>{formattedDate}</time>
      {readingTime && <span class="dot"></span>}
      {readingTime && <span>{readingTime} min</span>}
      <span class="card-arrow">→</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -16px rgba(217, 119, 87, 0.18);
    border-color: var(--peach);
  }

  .card.featured {
    grid-column: 1 / -1;
    flex-direction: row;
    background: linear-gradient(135deg, var(--cream), var(--paper));
  }

  .card-media {
    aspect-ratio: 16 / 9;
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .card.featured .card-media {
    aspect-ratio: auto;
    flex: 1;
    min-height: 320px;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .card:hover .card-media img {
    transform: scale(1.04);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 250, 243, 0.9);
    color: var(--terracotta-deep);
    display: grid;
    place-items: center;
    font-size: 18px;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .card-body {
    padding: 24px 28px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card.featured .card-body {
    padding: 48px 40px;
    justify-content: center;
    flex: 1;
  }

  .card-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terracotta-deep);
    margin-bottom: 12px;
  }

  .card-title {
    font-family: var(--display);
    font-size: 26px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    color: var(--ink);
  }

  .card.featured .card-title {
    font-size: clamp(32px, 4vw, 48px);
    margin-bottom: 16px;
  }

  .card-desc {
    font-size: 15px;
    color: var(--soft);
    line-height: 1.55;
    margin-bottom: 18px;
    flex: 1;
  }

  .card.featured .card-desc {
    font-size: 18px;
    max-width: 520px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
    margin-top: auto;
  }

  .card-meta .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--rule);
  }

  .card-arrow {
    margin-left: auto;
    font-size: 18px;
    color: var(--terracotta);
    transition: transform 0.2s;
  }

  .card:hover .card-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .card.featured {
      flex-direction: column;
    }
    .card.featured .card-media {
      min-height: 200px;
    }
    .card.featured .card-body {
      padding: 28px;
    }
  }
</style>
