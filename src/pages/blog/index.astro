---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Build sorted unique category list (most articles first)
const catCounts = new Map<string, number>();
for (const p of allPosts) {
  catCounts.set(p.data.category, (catCounts.get(p.data.category) ?? 0) + 1);
}
const categories = [...catCounts.entries()].sort((a, b) => b[1] - a[1]).map(([c]) => c);

// Helper: slugify category for data attribute
const slugifyCat = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
---

<BaseLayout
  title="Všetky články | Koniec Stresu"
  description="Praktické články o regulácii nervovej sústavy, spánku, úzkosti a meditácii. Bez moralizovania, len techniky, ktoré reálne fungujú."
>
  <header class="page-header">
    <div class="container container-narrow">
      <span class="page-tag">Blog &middot; {allPosts.length} článkov</span>
      <h1>Všetky <em>články</em></h1>
      <p class="lead">
        Praktické techniky proti stresu, úzkosti a nespavosti. Nové články pridávam pravidelne.
      </p>
      {categories.length > 1 && (
        <div class="filters" role="tablist" aria-label="Filtrovať podľa kategórie">
          <button
            type="button"
            class="filter active"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            Všetky <span class="filter-count">{allPosts.length}</span>
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              class="filter"
              data-filter={slugifyCat(cat)}
              role="tab"
              aria-selected="false"
            >
              {cat} <span class="filter-count">{catCounts.get(cat)}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  </header>

  <section class="grid-section">
    <div class="container">
      <div class="grid" id="article-grid">
        {allPosts.map((post) => (
          <div class="grid-item" data-category={slugifyCat(post.data.category)}>
            <ArticleCard
              href={`/blog/${post.id.replace(/\.md$/, '')}`}
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              publishDate={post.data.publishDate}
              readingTime={post.data.readingTime}
              videoId={post.data.videoId}
            />
          </div>
        ))}
      </div>
      <p class="empty-state" id="empty-state" hidden>
        Žiadny článok zatiaľ v tejto kategórii. Skús ďalšiu.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.grid-item');
  const empty = document.getElementById('empty-state');

  function applyFilter(slug: string) {
    let visibleCount = 0;
    items.forEach((item) => {
      const cat = item.dataset.category ?? '';
      const visible = slug === 'all' || cat === slug;
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });
    filters.forEach((f) => {
      const active = f.dataset.filter === slug;
      f.classList.toggle('active', active);
      f.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    if (empty) empty.hidden = visibleCount > 0;
  }

  filters.forEach((f) => {
    f.addEventListener('click', () => {
      const slug = f.dataset.filter ?? 'all';
      applyFilter(slug);
      // Update URL hash for shareability
      if (slug === 'all') {
        history.replaceState(null, '', window.location.pathname);
      } else {
        history.replaceState(null, '', `#${slug}`);
      }
    });
  });

  // Apply filter from URL hash on load
  const initialHash = window.location.hash.slice(1);
  if (initialHash) {
    applyFilter(initialHash);
  }
</script>

<style>
  .page-header {
    padding: 96px 24px 48px;
    text-align: center;
  }

  .page-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta-deep);
    margin-bottom: 16px;
  }

  .page-header h1 {
    font-family: var(--display);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 20px;
  }

  .page-header h1 em {
    font-style: italic;
    color: var(--terracotta);
  }

  .lead {
    font-size: 19px;
    color: var(--soft);
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.55;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--rule);
    font-size: 14px;
    color: var(--soft);
    font-weight: 500;
    cursor: pointer;
    font-family: var(--sans);
    transition: all 0.2s;
    line-height: 1;
  }

  .filter:hover {
    border-color: var(--terracotta);
    color: var(--terracotta-deep);
    background: var(--cream);
  }

  .filter.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .filter-count {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--terracotta-deep);
    font-weight: 600;
  }

  .filter.active .filter-count {
    background: rgba(255, 255, 255, 0.18);
    color: var(--paper);
  }

  .grid-section {
    padding: 48px 24px 96px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .grid-item {
    display: flex;
  }

  .grid-item :global(.card) {
    flex: 1;
    width: 100%;
  }

  .empty-state {
    text-align: center;
    padding: 64px 24px;
    color: var(--soft);
    font-size: 17px;
    font-style: italic;
    font-family: var(--display);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .filter {
      font-size: 13px;
      padding: 7px 14px;
    }
  }
</style>
