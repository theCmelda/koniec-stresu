---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTASection from '../components/CTASection.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const recent = allPosts.filter((p) => p.id !== featured?.id).slice(0, 6);
---

<BaseLayout
  title="Koniec Stresu — Praktické techniky proti stresu, úzkosti a nespavosti"
  description="Slovenský blog o regulácii nervovej sústavy. Konkrétne techniky proti stresu, úzkosti a nespavosti. Bez moralizovania, len to, čo funguje."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-card">
      <div class="hero-text">
        <span class="badge">Daniel Jedlička · Koniec Stresu</span>
        <h1>
          Praktické nástroje pre <em>pokojný</em> nervový systém.
        </h1>
        <p class="lead">
          Žiadne motivačné reči. Žiadny vodopád rád. Konkrétne techniky proti stresu,
          úzkosti a nespavosti, ktoré vieš začať robiť ešte dnes.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn-primary">Čítať články</a>
          <a href="#newsletter" class="btn-ghost">Stiahnuť 30-dňový plán</a>
        </div>
      </div>
      <div class="hero-mark">
        <div class="mark-circle"></div>
        <div class="mark-glow"></div>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  {featured && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Najnovšie</span>
          <h2>Čerstvé z blogu</h2>
        </div>
        <div class="grid">
          <ArticleCard
            href={`/blog/${featured.id.replace(/\.md$/, '')}`}
            title={featured.data.title}
            description={featured.data.description}
            category={featured.data.category}
            publishDate={featured.data.publishDate}
            readingTime={featured.data.readingTime}
            videoId={featured.data.videoId}
            featured
          />
          {recent.map((post) => (
            <ArticleCard
              href={`/blog/${post.id.replace(/\.md$/, '')}`}
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              publishDate={post.data.publishDate}
              readingTime={post.data.readingTime}
              videoId={post.data.videoId}
            />
          ))}
        </div>
        <div class="section-footer">
          <a href="/blog" class="btn-ghost">
            Pozrieť všetky články →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section class="section about" id="o-mne">
    <div class="container container-narrow">
      <div class="section-header">
        <span class="section-tag">O mne</span>
        <h2>Som Daniel. Posledných pár rokov pomáham ľuďom <em>vrátiť pokoj</em> nervovej sústave.</h2>
      </div>
      <div class="about-body">
        <p>
          Roky som žil s chronickým stresom a vôbec som si to neuvedomoval. Spánok zlý,
          podráždenosť vysoká, pocit, že to musím "len vydržať". Vydržať som to nemusel.
          Stačilo pochopiť, ako funguje nervová sústava a ako jej dať jasné signály bezpečia.
        </p>
        <p>
          Tento blog píšem pre ľudí, ktorí nechcú ďalšie motivačné reči. Chcú vedieť, čo
          presne urobiť, keď sa cítia preťažene. Všetko, čo tu zdieľam, som si najprv overil
          v praxi, na sebe a so stovkami ľudí v mojom programe.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    title="Tvoje telo nepotrebuje dokonalosť. Potrebuje <em>opakovanie.</em>"
    description="Stiahni si 30-dňový PDF plán Koniec Stresu. Denné cvičenia, jednoduché úlohy a audio nahrávky, ktoré ťa prevedú reguláciou nervovej sústavy krok za krokom."
  />
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding: 48px 24px 32px;
  }

  .hero-card {
    max-width: var(--max-width);
    margin: 0 auto;
    background: linear-gradient(135deg, var(--peach), var(--rose));
    border-radius: 36px;
    padding: 80px 56px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    align-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(217, 119, 87, 0.25);
  }

  .hero-card::before,
  .hero-card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-card::before {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, #fff, transparent 70%);
    opacity: 0.4;
    top: -120px;
    left: -100px;
  }
  .hero-card::after {
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, var(--olive-soft), transparent 70%);
    opacity: 0.5;
    bottom: -60px;
    right: 30%;
  }

  .hero-text {
    position: relative;
    z-index: 1;
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--terracotta-deep);
    font-weight: 500;
    margin-bottom: 24px;
  }

  .hero h1 {
    font-family: var(--display);
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.04;
    font-weight: 400;
    letter-spacing: -0.022em;
    margin-bottom: 24px;
    color: #3a2620;
  }

  .hero h1 em {
    font-style: italic;
    color: #7a3320;
  }

  .lead {
    font-size: 19px;
    color: #5d3a26;
    margin-bottom: 32px;
    line-height: 1.55;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-ghost {
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
    display: inline-block;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-primary:hover {
    background: var(--terracotta-deep);
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  .btn-ghost:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .hero-mark {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .mark-circle {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--terracotta), #7a3320);
    box-shadow: inset 0 -16px 32px rgba(0, 0, 0, 0.15), 0 30px 60px rgba(122, 51, 32, 0.3);
    position: relative;
    z-index: 2;
  }

  .mark-circle::before {
    content: '';
    position: absolute;
    inset: 28%;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.05);
  }

  .mark-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle, rgba(255, 233, 210, 0.5), transparent 60%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-card {
      grid-template-columns: 1fr;
      padding: 48px 32px;
    }
    .hero-mark {
      max-width: 220px;
      margin: 0 auto;
    }
  }

  /* SECTION */
  .section {
    padding: 96px 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta-deep);
    margin-bottom: 16px;
  }

  .section-header h2 {
    font-family: var(--display);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .section-header h2 em {
    font-style: italic;
    color: var(--terracotta);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .section-footer {
    text-align: center;
    margin-top: 48px;
  }

  /* ABOUT */
  .about-body {
    font-size: 19px;
    line-height: 1.78;
    color: var(--ink-2);
    text-align: left;
  }

  .about-body p {
    margin-bottom: 22px;
  }
</style>
